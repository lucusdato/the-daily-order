{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/daily/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/x",
      "destination": "/?ref=x",
      "permanent": false
    },
    {
      "source": "/share",
      "destination": "/?ref=share",
      "permanent": false
    },
    {
      "source": "/via/:src",
      "destination": "/?ref=:src",
      "permanent": false
    }
  ]
}
